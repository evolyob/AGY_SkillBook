        {
          "code": "B",
          "item": "是否留存系統存取紀錄(Log)"
        },
        {
          "code": "C",
          "item": "是否依工作權責給予適當之權限"
        },
        {
          "code": "D",
          "item": "是否定期檢視系統權限設定之合理性及必要性"
        },
        {
          "code": "E",
          "item": "是否設置逾時自動登出機制"
        },
        {
          "code": "F",
          "item": "是否不開放自外部連線存取系統(例外：申請短期開放，需求結束立即關閉)"
        },
        {
          "code": "G",
          "item": "是否具備個資遮蔽功能"
        },
        {
          "code": "H",
          "item": "是否影印機留存列印紀錄並定期覆核有無異常列印之情形"
        },
        {
          "code": "I",
          "item": "是否建立發生個資外洩之通報機制"
