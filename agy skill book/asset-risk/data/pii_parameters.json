  "risk_determination_matrix": {
    "formula": "R = Impact(I) * Probability(P)",
    "thresholds": {
      "acceptable": {
        "score_range": [
          1,
          2,
          3,
          4
        ],
        "label": "可接受",
        "action": "常規作業與持續監控，無須額外對策"
      },
      "unacceptable": {
        "score_range": [
          6,
          9
        ],
        "label": "不可接受",
        "action": "必須列入《風險改善計畫表》，限期落實改善措施並追蹤殘餘風險"
      }
    },
    "grid": {
