  "impact_evaluation_matrix": {
    "calculation_rule": "各構面評定1~3分，衝擊程度(I)取六大構面之最大值 MAX(可識別性, 個資數量, 敏感程度, 特定目的利用, 外部利用, 國際傳輸)",
    "dimensions": [
      {
        "id": "identifiability",
        "name": "可識別性",
        "levels": {
          "1": "無法、個資查詢困難、或需耗時過久、耗費過鉅才能辨識特定當事人者",
          "2": "可間接辨識特定當事人者",
          "3": "可直接辨識特定當事人者"
        }
      },
      {
        "id": "quantity",
        "name": "個資數量",
        "levels": {
          "1": "20筆以下 (團體訴訟不成立)",
          "2": "一般個資21~10,000筆 或 特種個資21~1,000筆",
          "3": "一般個資10,001筆以上 或 特種個資1,001筆以上"
        }
      },
      {
        "id": "sensitivity",
        "name": "敏感程度",
        "levels": {
          "1": "僅有一般辨識資料，未包含其他個人活動資料",
          "2": "有個人活動資料 (消費、軌跡、出差紀錄等)",
          "3": "包含特種個資 (醫療、健檢、犯罪等)"
        }
      },
      {
        "id": "purpose_compliance",
        "name": "特定目的範圍內利用",
        "levels": {
          "1": "特定目的範圍內利用",
          "2": "特定目的範圍外利用之法定例外情形",
          "3": "特定目的範圍外之利用"
        }
      },
      {
        "id": "external_use",
        "name": "外部利用",
        "levels": {
          "1": "無外部利用情形",
          "2": "無償委任關係外部利用",
          "3": "有償委任關係外部利用"
        }
      },
      {
        "id": "international_transfer",
        "name": "國際傳輸",
        "levels": {
          "1": "無國際傳輸情形",
          "2": "主管機關未規定限制之國際傳輸",
          "3": "主管機關有規定限制之國際傳輸"
        }
      }
    ],
    "guidelines": {
      "direct_identification": "透過資料本身即可直接連結至特定個人 (如：姓名、國民身分證統一編號、護照號碼)",
      "indirect_identification": "須與其他資料相互對照、組合、連結方能識別特定人 (如：員工編號、設備ID、IP位址、帳單流水號、交易明細)",
      "special_categories_rule": "只要檔案內含有特種個資 (醫療、健檢、犯罪等)，敏感程度構面直接強制為 3 分 (嚴重)，即便筆數少亦同"
    },
