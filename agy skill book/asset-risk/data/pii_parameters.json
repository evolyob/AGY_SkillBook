  "control_measures_by_data_type": {
    "calculation_rule": "依現有措施數量(Count)判定風險發生可能性(P)：>=8項為低(1)，5~7項為中(2)，<5項為高(3)。公式: IF(Count>=5, IF(Count>=8, 1, 2), 3)",
    "types": {
      "電子檔": [
        {
          "code": "A",
          "item": "是否需透過帳號密碼方可操作存取檔案之電腦，且無共用帳號密碼"
        },
        {
          "code": "B",
          "item": "存取檔案之電腦是否設有逾時啟動螢幕保護程式機制"
        },
        {
          "code": "C",
          "item": "存取檔案之電腦是否不開放使用USB、外接硬碟、燒錄等功能"
        },
        {
          "code": "D",
          "item": "是否未將電腦帳號密碼保存於他人易於取得之處"
        },
        {
          "code": "E",
          "item": "是否於其他部門或外部人員調閱資料時，確認其必要性及合理性"
        },
        {
          "code": "F",
          "item": "是否將備份資料放置於非權責人員無法存取之處"
        },
        {
          "code": "G",
          "item": "是否保存期限屆滿後妥善銷毀"
        },
        {
          "code": "H",
          "item": "當有必要列印檔案時，是否確認影印機有留存列印紀錄並定期覆核有無異常列印之情形"
        },
        {
          "code": "I",
          "item": "是否建立發生個資外洩之通報機制"
        },
        {
          "code": "J",
          "item": "是否定期舉行個資保護教育訓練增強個資保護意識及概念"
        }
      ],
      "系統": [
        {
          "code": "A",
          "item": "是否需透過帳號密碼存取系統，且無共用帳號密碼"
