{
  "linter": {
    "max_file_size_bytes": 46080,
    "exempt_files": ["index.md", "log.md", ".wiki-schema.md", ".wiki-cache.json"],
    "exempt_prefixes": [".", "raw/"],
    "patterns": {
      "wikilink": "\\[\\[(.*?)\\]\\]",
      "sep_cell": "\\|\\s*:?-{2,}:?\\s*\\|",
      "pure_sep": "^\\s*\\|?[\\s:|-]+\\|?\\s*$",
      "fence": "^\\s*(```|~~~)",
      "quote_header": "^#{1,6}\\s+.*(?:quote|citation|notable).*$"
    }
  },
  "query": {
    "default_limit": 5,
    "title_weight": 10.0,
    "glossary_fields": ["entity", "abbr", "term_zh", "term_en"],
    "entity_labels": {
      "abbr": "Abbreviation",
      "aliases": "Aliases",
      "definition": "Definition"
    }
  },
  "scaffold": {
    "directories": [
      "raw/articles",
      "raw/notes",
      "raw/pdfs",
      "raw/assets",
      "wiki/entities",
      "wiki/topics",
      "wiki/sources",
      "wiki/comparisons",
      "wiki/synthesis",
      "wiki/queries",
      "templates",
      "data"
    ],
    "initial_terms": [
      {
        "term_zh": "檢索增強生成",
        "term_en": "Retrieval-Augmented Generation",
        "abbr": "RAG",
        "entity": "rag",
        "aliases": ["檢索增強生成", "Retrieval-Augmented Generation", "RAG"],
        "definition": "結合外部檢索機制與大型語言模型生成能力之架構。"
      },
      {
        "term_zh": "大型語言模型",
        "term_en": "Large Language Model",
        "abbr": "LLM",
        "entity": "llm",
        "aliases": ["大型語言模型", "Large Language Model", "LLM"],
        "definition": "基於海量文字預訓練並具備語言理解與生成能力之深度學習模型。"
      }
    ]
  },
  "flatten": {
    "max_chapter_bytes": 40000,
    "min_chapter_chars": 80,
    "min_chars_per_page_ocr": 50,
    "single_agent_max_bytes": 81920,
    "single_agent_max_chapters": 6,
    "batch_target_bytes": 65536,
    "patterns": {
      "toc_dot": "(?:\\.{3,}|(?:\\.\\s*){3,}|·{3,}|…{2,})\\s*\\d+\\s*$",
      "page_num": "^(?:[-－—–]\\s*\\d+\\s*[-－—–]|\\(\\s*共\\s*\\d+\\s*頁\\s*\\)|Page\\s+\\d+(?:\\s+of\\s+\\d+)?|:20\\d{2}|CNS\\s+\\d+[\\d\\s\\-:]*)$",
      "heading": "^(?:#{1,2}\\s+.+|第\\s*[0-9一二三四五六七八九十百]+\\s*[章節編篇條](?:\\s+.+)?|(?:Chapter|Section)\\s+\\d+[:\\s].+|\\d{1,2}\\.\\s*(?:[\\u4e00-\\u9fffA-Za-z].*)|[一二三四五六七八九十]+、\\s*[\\u4e00-\\u9fffA-Za-z].*|(?:前言|簡介|附錄\\s*[A-Z0-9一二三四五六七八九十]+|參考資料|參考文獻|名詞對照)(?:\\s+.*)?$)$",
      "sub_heading": "^(?:#{2,4}\\s+.+|\\d{1,2}\\.\\d+(?:\\.\\d+)?\\s+[\\u4e00-\\u9fffA-Za-z].+)$"
    }
  }
}
