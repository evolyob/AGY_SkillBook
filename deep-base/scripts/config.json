{
  "linter": {
    "max_file_size_bytes": 46080,
    "exempt_files": ["index.md", "log.md", ".wiki-schema.md", ".wiki-cache.json"],
    "exempt_prefixes": [".", "raw/", "templates/", "wiki/archive/"],
    "patterns": {
      "wikilink": "\\[\\[(.*?)\\]\\]",
      "sep_cell": "\\|\\s*:?-{2,}:?\\s*\\|",
      "pure_sep": "^\\s*\\|?[\\s:|-]+\\|?\\s*$",
      "fence": "^\\s*(```|~~~)",
      "quote_header": "^#{1,6}\\s+.*(?:quote|citation|notable|引文|引述).*$"
    },
    "valid_domains": ["ai", "tech", "rmf", "compliance", "work"],
    "required_entity_tags": ["entity"]
  },
  "query": {
    "default_limit": 5,
    "title_weight": 10.0,
    "glossary_fields": ["entity", "abbr", "term_zh", "term_en"],
    "entity_labels": {
      "abbr": "Abbreviation",
      "aliases": "Aliases",
      "definition": "Definition"
    }
  },
  "scaffold": {
    "directories": [
      "raw/articles",
      "raw/notes",
      "raw/notes/archive",
      "raw/pdfs",
      "raw/assets",
      "wiki/entities",
      "wiki/topics",
      "wiki/sources",
      "wiki/comparisons",
      "wiki/synthesis",
      "wiki/queries",
      "wiki/archive",
      "templates",
      "data"
    ],
    "initial_terms": [
      {
        "term_zh": "檢索增強生成",
        "term_en": "Retrieval-Augmented Generation",
        "abbr": "RAG",
        "entity": "rag",
        "aliases": ["檢索增強生成", "Retrieval-Augmented Generation", "RAG"],
        "definition": "結合外部檢索機制與大型語言模型生成能力之架構。"
      },
      {
        "term_zh": "大型語言模型",
        "term_en": "Large Language Model",
        "abbr": "LLM",
        "entity": "llm",
        "aliases": ["大型語言模型", "Large Language Model", "LLM"],
        "definition": "基於海量文字預訓練並具備語言理解與生成能力之深度學習模型。"
      }
    ]
  },
  "flatten": {
    "max_chapter_bytes": 40000,
    "min_chapter_chars": 80,
    "min_chars_per_page_ocr": 50,
    "single_agent_max_bytes": 81920,
    "single_agent_max_chapters": 6,
    "batch_target_bytes": 65536,
    "patterns": {
      "toc_dot": "(?:\\.{3,}|(?:\\.\\s*){3,}|·{3,}|…{2,})\\s*\\d+\\s*$",
      "page_num": "^(?:[-－—–]\\s*\\d+\\s*[-－—–]|\\(\\s*共\\s*\\d+\\s*頁\\s*\\)|Page\\s+\\d+(?:\\s+of\\s+\\d+)?|:20\\d{2}|CNS\\s+\\d+[\\d\\s\\-:]*)$",
      "heading": "^(?:#{1,2}\\s+.+|第\\s*[0-9一二三四五六七八九十百]+\\s*[章節編篇條](?:\\s+.+)?|(?:Chapter|Section|Module|Lesson|Domain|Unit)\\s+[0-9A-Z]+(?:[:\\s-].*)?|\\d{1,2}\\.\\s*(?:[\\u4e00-\\u9fffA-Za-z].*)|[一二三四五六七八九十]+、\\s*[\\u4e00-\\u9fffA-Za-z].*|(?:前言|簡介|附錄\\s*[A-Z0-9一二三四五六七八九十]+|參考資料|參考文獻|名詞對照)(?:\\s+.*)?$)$",
      "sub_heading": "^(?:#{2,4}\\s+.+|(?:\b[A-Z]{2,3}-\\d+|\\d{1,2}\\.\\d+(?:\\.\\d+)?)\\s+[\\u4e00-\\u9fffA-Za-z].+)$"
    },
    "raw_slice_schema": {
      "deconstruction_contracts": {
        "metric_chart": {
          "description": "Deconstruct quantitative bar, line, and pie charts into structured data tables",
          "markdown_header": "| 統計指標/維度 (Metric/Dimension) | 測量數值與單位 (Value) | 基準線對比增減 (Delta) | 實體脈絡與關鍵成因 (Context) |"
        },
        "timeline_gantt": {
          "description": "Deconstruct Gantt charts, roadmaps, and phase schedules into dependency tables",
          "markdown_header": "| 階段代號 (Phase) | 任務名稱 (Task) | 工期/時程 (Duration) | 前置依賴項 (Prerequisites) | 負責角色與關鍵交付物 (Owner/Deliverables) |"
        },
        "topology_diagram": {
          "description": "Deconstruct architecture, network, and dataflow diagrams into native Mermaid and flow tables",
          "mermaid_type": "flowchart TD or flowchart LR",
          "markdown_header": "| 傳輸來源節點 (Source) | 目標節點 (Destination) | 安全協定與通訊埠 (Protocol/Port) | 資料流動作與防護檢核 (Action/Controls) |"
        }
      }
    }
  },
  "sanitize": {
    "patterns": {
      "pseudo_wikilink": "\\[\\[([^\\/\\\\\\]\\n]+\\/[^\\/\\\\\\]\\n]+)\\]\\]",
      "hackmd_fence": "^(\\s*```+)([a-zA-Z0-9_\\-]+)[=!]+.*$",
      "hackmd_empty_fence": "^(\\s*```+)[=!]+.*$",
      "collapsed_table_sep": "^>\\s*(\\|[\\s\\-:|]+\\|)\\s*$",
      "fence_line": "^\\s*(```+|~~~+)",
      "open_fence_line": "^\\s*(```+|~~~+)[a-zA-Z0-9_\\-]+",
      "hr_line": "^---\\s*$",
      "sec_heading": "^##\\s+\\d+\\.\\s+.*\\(來源:|^##\\s+關聯實體與擴展防護"
    }
  },
  "hygiene": {
    "redact_patterns": {
      "secret_token": "\\b(?:sk-(?:proj-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35})\\b",
      "private_key": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z0-9 ]*PRIVATE KEY-----",
      "tw_phone": "(?<!\\d)09\\d{2}[-\\s]?\\d{3}[-\\s]?\\d{3}(?!\\d)"
    }
  }
}
